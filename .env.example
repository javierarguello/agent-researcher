# ---------------------------------------------------------------------------
# agent-researcher — environment configuration
# Copy to .env for local dev. On Cloud Run these are set as service/job env vars.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# "dev" | "prod" — names every stateful resource (bucket, Firestore DB, SAs,
# Cloud Run service/job) so the two environments never collide.
ENV=dev

# --- GCP / Vertex ----------------------------------------------------------
# Same GCP project as home-assistant for both environments.
GCP_PROJECT_ID=sinuous-canto-497518-h7
GCP_LOCATION=us-central1

# Defaults derive from ENV; override only if you need custom names.
# Cloud Storage bucket for research outputs (researchs/{jobId}/**).
RESEARCH_BUCKET=agent-researcher-dev-reports
# Named Firestore database (one per environment).
FIRESTORE_DATABASE=agent-researcher-dev

# --- AI models (pluggable, per-agent) --------------------------------------
# Default provider; "claude" later via the same LlmProvider interface.
LLM_PROVIDER=gemini-vertex
# Concrete models behind the model-registry aliases. Agents reference ALIASES
# ('gather','flash','pro', later 'claude-sonnet') — never these ids directly —
# so swapping a model/provider never touches a template or agent.
LLM_MODEL_FLASH=gemini-2.5-flash
LLM_MODEL_PRO=gemini-2.5-pro
# Default aliases for an agent's research loop vs. structured synthesis.
LLM_DEFAULT_GATHER=gather
LLM_DEFAULT_SYNTH=pro
# Upper bound for structured JSON output (avoids mid-JSON truncation).
LLM_MAX_OUTPUT_TOKENS=16384
# Max agents running concurrently per job (Vertex quota guard; 429s are common
# on this project — keep low, the provider also retries with backoff).
LLM_MAX_CONCURRENT_AGENTS=2

# --- Local models (development / testing) ----------------------------------
# Point any alias at a local Ollama server instead of Vertex — no cloud
# credentials, no token bill. See docker-compose.local.yml + docs/local-llm.md.
#   docker compose -f docker-compose.local.yml up -d
#   LLM_PROVIDER_FLASH=ollama LLM_MODEL_FLASH=qwen2.5:3b npm run dev:api
# LLM_PROVIDER_FLASH=ollama
# LLM_PROVIDER_GATHER=ollama
# LLM_PROVIDER_PRO=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_MS=180000

# --- Request review (moderation + pre-flight) ------------------------------
# The LLM classifier on top of the deterministic pre-screen. "false" keeps the
# free, rule-based screen only (used by the test suites).
MODERATION_LLM=true
# The assisted half of the pre-flight review (typo corrections + extra finding
# codes). The deterministic half — summary + rules — always runs.
VALIDATION_LLM=true
# Assisted reviews for ONE report being drafted. The user can act on the findings
# and re-check, but past this the review goes deterministic-only and generation
# proceeds — no wait, no penalty. This is what stops an endless
# revalidate-and-recommend loop on the same request.
PREFLIGHT_ASSIST_ATTEMPTS=2
# Backstop across all drafts per user, within the window below. Set well clear of
# real use: it only catches a client cycling draft ids. Only this one pauses.
PREFLIGHT_ASSIST_USER_ATTEMPTS=30
# Escalating pause, in hours, applied each time THAT backstop is tripped.
PREFLIGHT_COOLDOWN_HOURS=1,6,24,72
# Sliding window (hours) after which the per-user counter restarts on its own.
PREFLIGHT_WINDOW_HOURS=8

# --- Abuse limits on the UNAUTHENTICATED endpoints -------------------------
# These cost real money (Postmark sends, password hashing) and have no session to
# meter, so they are capped per client IP and per target email. 0 disables one.
PUBLIC_BURST_PER_MINUTE=30
PUBLIC_REGISTER_PER_HOUR_IP=5
PUBLIC_REGISTER_PER_HOUR_EMAIL=3
PUBLIC_LOGIN_PER_HOUR_IP=30
PUBLIC_LOGIN_PER_HOUR_EMAIL=10
PUBLIC_RESET_PER_HOUR_IP=5
PUBLIC_RESET_PER_HOUR_EMAIL=3
PUBLIC_CONTACT_PER_HOUR_IP=5
PUBLIC_TOKEN_PER_HOUR_IP=30
PUBLIC_PLANS_PER_HOUR_IP=60
CHECKOUT_PER_HOUR_PER_USER=20
# X-Forwarded-For entries added by infrastructure BEYOND the one holding the real
# peer — how many to drop when deriving a client IP the caller cannot forge.
#   0 = reached directly on *.run.app (this deployment): Cloud Run appends the
#       peer, so the LAST entry is real and anything before it is caller-written.
#   1 = behind a global external load balancer, which appends its own address.
# Too high and every per-IP limit keys on a header the attacker controls.
TRUSTED_PROXY_HOPS=0

# --- Cloudflare Turnstile (bot check) --------------------------------------
# The SECRET for the widget registered in the Cloudflare dashboard. Server-side
# only — it must never reach the browser. Empty disables the check entirely, so
# nothing breaks before it is configured.
TURNSTILE_SECRET=
# Public site key. Already defaults to the project's registered widget in code;
# set it here only to point at a different widget.
TURNSTILE_SITE_KEY=0x4AAAAAAD_OEtqrL5B2NN6f
# Which flows require a solved widget. A route binds itself to a flow name, so
# protecting or unprotecting one is a deploy-time decision, not a code change.
# Known flows: register, login, password-reset, contact, research, preflight.
TURNSTILE_FLOWS=register,login,password-reset,contact,research,preflight
