# Base URL of the agent-researcher API (no trailing slash).
VITE_API_BASE_URL=https://agent-researcher-dev-api-b74fjmzlha-uc.a.run.app

# The fbizlab app's Google OAuth client id (its own — separate from admin).
# Must match the `fbizlab` app doc's googleClientId in Firestore.
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# The app id this web app authenticates as.
VITE_APP_ID=fbizlab

# Cloudflare Turnstile SITE key (public; pairs with the API's TURNSTILE_SECRET).
# Defaults to the project's registered widget, so it works without setting this.
# Empty = the widget is not rendered at all.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAD_OEtqrL5B2NN6f
